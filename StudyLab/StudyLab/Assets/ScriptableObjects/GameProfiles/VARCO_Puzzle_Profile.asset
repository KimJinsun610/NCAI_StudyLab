  objectiveText: "\uC0C1\uC790\uC640 \uC555\uB825\uD310\uC73C\uB85C \uBB38 \uD37C\uC990\uC744
    \uD480\uACE0 \uD0C8\uCD9C\uD558\uC138\uC694."
  controlGuideText: "\uC774\uB3D9: WASD | \uC2DC\uC810: \uB9C8\uC6B0\uC2A4 | \uC218\uC9D1:
    \uC544\uC774\uD15C\uC5D0 \uB2FF\uAE30 | \uD37C\uC990: \uC0C1\uC790 \uBC00\uAE30/\uC555\uB825\uD310"
  clearMessage: "\uD37C\uC990 \uAC8C\uC784\uC744 \uD074\uB9AC\uC5B4\uD588\uC2B5\uB2C8\uB2E4.
    \uC0C8 \uC5D0\uC14B\uC774\uB098 \uBE14\uB85D\uC744 \uBC14\uAFD4 \uB2E4\uB978
    \uBC84\uC804\uB3C4 \uB9CC\uB4E4\uC5B4\uBCF4\uC138\uC694."
  gameOverMessage: "\uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4. \uB09C\uC774\uB3C4, \uC801
    \uC218, \uC81C\uD55C\uC2DC\uAC04\uC744 \uC870\uC815\uD574 \uB2E4\uC2DC \uB3C4\uC804\uD558\uC138\uC694."
  designNotes: "VARCO \uAC8C\uC784 \uBA54\uC774\uCEE4\uB85C \uC0DD\uC131\uB428. \uBE14\uB85D:
    \uB09C\uC774\uB3C4(\uBCF4\uD1B5), \uCE74\uBA54\uB77C(\uCFFC\uD130\uBDF0), \uC774\uB3D9(\uCE74\uBA54\uB77C
    \uAE30\uC900 \uC774\uB3D9), \uD50C\uB808\uC774\uC5B4(\uD37C\uC990), \uC218\uC9D1
    \uC544\uC774\uD15C(2), \uBAA9\uD45C \uC9C0\uC810, \uBB38 \uD37C\uC990, \uBC00
    \uC218 \uC788\uB294 \uC0C1\uC790, \uD658\uACBD \uC18C\uD488/\uC5C4\uD3D0\uBB3C,
    \uD0C0\uC774\uBA38(180\uCD08)"
